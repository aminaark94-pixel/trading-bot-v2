{
  "testnet": false,
  "symbols": ["BTC/USDT", "ETH/USDT", "SOL/USDT"],
  "timeframe": "15m",
  "ohlcv_limit": 100,
  "trade_allocation_usdt": 50.0,
  "max_open_trades_per_bot": 2,
  "bots": {
    "RSI_Bollinger": {
      "enabled": true,
      "rsi_period": 14,
      "bb_period": 20,
      "bb_std": 2.0,
      "rsi_oversold": 30,
      "rsi_overbought": 70,
      "tp_percent": 2.0,
      "sl_percent": 1.5
    },
    "MACD_Momentum": {
      "enabled": true,
      "fast_period": 12,
      "slow_period": 26,
      "signal_period": 9,
      "tp_percent": 2.0,
      "sl_percent": 1.5
    },
    "EMA_Cross": {
      "enabled": true,
      "fast_ema": 9,
      "slow_ema": 21,
      "trend_ema": 50,
      "tp_percent": 2.0,
      "sl_percent": 1.5
    },
    "Breakout_Volume": {
      "enabled": true,
      "lookback_period": 20,
      "volume_multiplier": 1.8,
      "tp_percent": 2.5,
      "sl_percent": 1.5
    },
    "Mean_Reversion": {
      "enabled": true,
      "z_score_period": 20,
      "entry_threshold": 2.0,
      "tp_percent": 2.0,
      "sl_percent": 1.5
    }
  }
}
