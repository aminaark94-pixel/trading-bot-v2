# --- AI on/off master switch ---
# true  = bots use Gemini/Groq/Mistral vision AI to decide signals
# false = bots use pure technical-indicator rules, no AI calls at all (free, no AI cost)
AI_ENABLED=false

# --- AI provider keys (only needed if AI_ENABLED=true) ---
# Comma-separated lists — same format as before, just moved out of the code.
GEMINI_KEYS=your_gemini_key_1,your_gemini_key_2
GROQ_KEYS=your_groq_key_1,your_groq_key_2
MISTRAL_KEYS=your_mistral_key_1,your_mistral_key_2

# --- Discord webhook (optional) ---
# Channel Settings -> Integrations -> Webhooks -> New Webhook -> copy URL
DISCORD_WEBHOOK_URL=

# --- Binance Futures TESTNET keys (only needed for the "Take Trade Demo" button) ---
# Get these from https://testnet.binancefuture.com — never your real Binance keys.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Port (Render sets this automatically, safe to leave blank locally) ---
PORT=5055
